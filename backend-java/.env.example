# 店小约后端环境变量示例。复制为 .env 并按需修改，.env 已被 Git 忽略，真实密钥不得提交。

# ---- MySQL（业务数据库，唯一业务数据源）----
DB_URL=jdbc:mysql://localhost:3306/shop_booking?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=你的MySQL密码

# ---- Redis（可选：仅存可重建状态，清空不丢订单；未安装可保持默认，系统自动降级）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT（必填，至少 32 字节，否则启动失败）----
JWT_SECRET=please-change-this-to-a-random-secret-at-least-32-bytes!

# ---- DeepSeek（建议留空，启动后由老板在网页「店铺设置 → AI 客服设置」中填写，AES 加密存库、改后即生效）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 服务 ----
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
